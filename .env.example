# Groq API key — основний LLM-провайдер (https://console.groq.com/keys)
GROQ_API_KEY=

# OpenRouter API key — fallback для LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# DOM.RIA API key (https://developers.ria.com/)
DOMRIA_API_KEY=

# Вимкнути локальні моделі (якщо немає transformers/torch)
ENABLE_LOCAL_VISION=true

# Порт сервера
PORT=8000
